# MotionEye 摄像头配置模板
# @id __CAMERA_ID__
# @name __CAMERA_NAME__
# @type network
# 由 entrypoint.sh 根据环境变量生成 thread-1.conf
#
# 占位符说明:
#   __CAMERA_URL__      → $CAMERA_URL 环境变量（RTSP/MJPEG 流地址）
#   __CAMERA_USERNAME__ → $CAMERA_USERNAME 环境变量
#   __CAMERA_PASSWORD__ → $CAMERA_PASSWORD 环境变量

# ===== 网络摄像头设置 =====
# 摄像头名称
camera_name __CAMERA_NAME__

# 网络摄像头 URL（如果是内网摄像头，可通过 Cloudflare Access 穿透连接）
netcam_url __CAMERA_URL__

# 摄像头认证
netcam_userpass __CAMERA_USERNAME__:__CAMERA_PASSWORD__

# 强制使用 TCP 传输 RTSP（这对 Cloudflare Tunnel 穿透至关重要，因为不支持 UDP）
netcam_use_tcp on

# 保持连接（减少重连开销）
netcam_keepalive on

# 连接容忍度（网络不稳定时允许更多重试）
netcam_tolerant_check on

# ===== 极低内存 Passthrough 模式 =====

# 帧率：最低处理帧率（减少内存占用）
framerate 2

# 分辨率（仅用于内部缓冲，passthrough 不影响录制分辨率）
width 640
height 360

# ===== 彻底关闭运动检测（节省 CPU/内存） =====

# 模拟运动 → 持续录制（不做真正的运动检测分析）
# @motion_detection off
# @record_mode 2
# @movies on
emulate_motion on

# 关闭运动定位标记
locate_motion_mode off

# 关闭运动区域显示
locate_motion_style off

# 阈值设置极高（即使有残余检测也不触发）
threshold 2147483647

# ===== 视频录制设置（Passthrough） =====

# 开启视频录制
ffmpeg_output_movies on

# 视频编码：MP4 H.264
ffmpeg_video_codec mp4

# 核心：开启直通模式（不解码，不重编码）
movie_passthrough on

# 保存视频时间（7天=1周），MotionEye 会自动清理过期视频
# @preserve_movies 7

# 每段视频最大时长（秒）—— 5分钟分片，方便 Rclone 尽快搬走
movie_max_time 300

# 视频文件名格式
movie_filename %Y-%m-%d/%H-%M-%S

# ===== 关闭图片输出（节省内存和存储） =====

# 不生成快照图片
picture_output off

# 不生成运动检测图片
picture_output_motion off

# ===== 文本叠加（passthrough 模式下无效，关闭） =====
text_left off
text_right off
text_changes off

# ===== 存储路径 =====
target_dir /var/lib/motioneye/__CAMERA_NAME__

# ===== 流设置 =====
stream_port __STREAM_PORT__
stream_localhost on
stream_maxrate 1
stream_quality 50
